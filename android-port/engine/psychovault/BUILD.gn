import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

generate_jni("jni_headers") {
  # These bindings intentionally use JNI Zero's default JavaRef<jobject> and
  # JavaRef<jstring> parameters. Do not depend on the Profile/Content Java
  # compilation targets here: chrome_java consumes our generated Java source,
  # so pulling those targets into this generator creates a header dependency
  # cycle through base_java. The native implementations convert the object
  # references explicitly in the browser target that already owns those types.
  sources = [
    "java/org/chromium/chrome/browser/psychovault/PsychoProfileStore.java",
    "java/org/chromium/chrome/browser/psychovault/PsychoExtensions.java",
    "java/org/chromium/chrome/browser/psychovault/PsychoDownloads.java",
    "java/org/chromium/chrome/browser/psychovault/PsychoNetwork.java",
    "java/org/chromium/chrome/browser/psychovault/PsychoPerformance.java",
    "java/org/chromium/chrome/browser/psychovault/PsychoVaultStore.java",
  ]
}


android_assets("bundled_extensions_assets") {
  disable_compression = true
  renaming_sources = [ "bundled/proton-vpn.zip", "bundled/dark-reader.zip", "bundled/blocklist.json" ]
  renaming_destinations = [ "psychovault/bundled/proton-vpn.zip", "psychovault/bundled/dark-reader.zip", "psychovault/bundled/blocklist.json" ]
}

android_assets("ui_assets") {
  disable_compression = true
  renaming_sources = [
    "ui/index.html", "ui/style.css", "ui/mobile.css", "ui/renderer.js",
    "ui/sidebar.js", "ui/mobile-shell.js", "ui/desktop-bridge.js",
    "ui/internal-page-bridge.js", "ui/navigation-resolver.js",
    "ui/native-transport.js", "ui/host-layout.js", "ui/chrome-bootstrap.js",
    "ui/newtab.html", "ui/newtab.js", "ui/page-bootstrap.js", "ui/icon.png",
    "ui/settings.html", "ui/settings.js", "ui/recovery.html", "ui/recovery.js", "ui/library.js", "ui/library-transport.js", "ui/indexeddb-storage.js",
  ]
  renaming_destinations = [
    "psychovault/ui/index.html", "psychovault/ui/style.css", "psychovault/ui/mobile.css", "psychovault/ui/renderer.js",
    "psychovault/ui/sidebar.js", "psychovault/ui/mobile-shell.js", "psychovault/ui/desktop-bridge.js",
    "psychovault/ui/internal-page-bridge.js", "psychovault/ui/navigation-resolver.js",
    "psychovault/ui/native-transport.js", "psychovault/ui/host-layout.js", "psychovault/ui/chrome-bootstrap.js",
    "psychovault/ui/newtab.html", "psychovault/ui/newtab.js", "psychovault/ui/page-bootstrap.js", "psychovault/ui/icon.png",
    "psychovault/ui/settings.html", "psychovault/ui/settings.js", "psychovault/ui/recovery.html", "psychovault/ui/recovery.js", "psychovault/ui/library.js", "psychovault/ui/library-transport.js", "psychovault/ui/indexeddb-storage.js",
  ]
}
