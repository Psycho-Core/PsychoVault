# --- PsychoVault build projects that predate this layout
PsychoVault/PsychoVaultExe/
/Exe

# --- dependencies
node_modules/

# --- build output
build/
dist/
payload/
PsychoVault-Setup-*.exe
Release-Notes-*.txt
update-manifest.json
update-manifest.sig

# --- Electron runtime archives (about 150 MB each)
electron-v*.zip
electron*.zip
*.7z

# --- secrets: never commit any of these
update-token.json
publish-token.json
app/update-token.json
*-signing-key.pem
update-private-key*
*.key
.env
.env.*

# --- logs and diagnostics
*.log
npm-debug.log*
errors.log

# --- editors and OS junk
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
*.lnk

# --- the app's npm lockfile; Electron is pinned in package.json, and npm rewrites this
app/package-lock.json
1.txt
